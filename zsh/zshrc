# source antidote
source "${ZDOTDIR}/../antidote/antidote.zsh"

# initialize plugins statically with ${ZDOTDIR:-~}/.zsh_plugins.txt
antidote load

# Source p10k theme based on system appearance, re-evaluate on each prompt
function _p10k_switch_theme() {
  local mode=dark
  if [[ "$(uname)" == "Darwin" ]]; then
    if [[ "$(defaults read -g AppleInterfaceStyle 2>/dev/null)" != "Dark" ]]; then
      mode=light
    fi
  fi
  if [[ "$mode" != "$_P10K_THEME_MODE" ]]; then
    _P10K_THEME_MODE=$mode
    source ~/.dotfiles/zsh/.p10k-${mode}.zsh
  fi
}
_p10k_switch_theme
autoload -Uz add-zsh-hook
add-zsh-hook precmd _p10k_switch_theme

# select prompt theme
autoload -Uz promptinit && promptinit && prompt powerlevel10k

# Configure vimrc location
export VIMINIT='source $MYVIMRC'
export MYVIMRC='~/.dotfiles/vim/vimrc'

export SSLKEYLOGFILE=~/.ssl-key.log

if [ -r ~/.profile ]; then
  emulate sh
  . ~/.profile
  emulate zsh
fi
